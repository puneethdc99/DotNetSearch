<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>DotNetSearch</AssemblyName>
    <RootNamespace>DotNetSearch</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>Puneeth DC</Authors>
    <Description>Token-efficient MCP search server for AI agents - keyword and BM25 search over local directories.</Description>
    <RepositoryUrl>https://github.com/puneethdc99/DotNetSearch</RepositoryUrl>

    <!--
      Self-contained: bundles the .NET runtime inside the exe.
      No .NET installation required on the target machine.
      PublishSingleFile: merges all assemblies into one executable.
      These are publish-time settings; dotnet run / debug still work normally.
    -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

    <!-- Trim unused framework code to reduce file size -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>

    <!-- Smaller binary: strip debug symbols from the published exe -->
    <StripSymbols>true</StripSymbols>

    <!-- Avoids ICU/globalization dependency � smaller and fully portable -->
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Required: keeps System.Text.Json reflection working after trim -->
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FreeSpire.PDF" Version="12.4.0" />
    <PackageReference Include="ICSharpCode.Decompiler" Version="10.0.1.8346" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.8" />
    <PackageReference Include="ModelContextProtocol" Version="1.3.0" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.11" />
  </ItemGroup>

</Project>
